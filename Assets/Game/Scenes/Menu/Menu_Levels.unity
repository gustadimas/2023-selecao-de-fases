  m_Script: {fileID: 11500000, guid: 1241c28f57348b8418c3c0c970473a7a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  levelNm: Pelourinho
  desc: "O Pelourinho, localizado no centro hist\xF3rico de Salvador, Bahia, \xE9
    um bairro vibrante e culturalmente rico que possui imenso significado hist\xF3rico.
    Conhecido por sua arquitetura colonial colorida e bem preservada, com suas estreitas
    ruas adornadas com belos edif\xEDcios em tons past\xE9is, fachadas ornamentadas
    e sacadas primorosamente projetadas. O distrito \xE9 um Patrim\xF4nio Mundial
    da UNESCO e serve como um testemunho vivo do passado colonial do Brasil"
  levelId: 2
  completed: 0
  objectivesDone: 0
  isSelected: 0
  GMlink: https://www.google.com.br/maps/place/Pelourinho,+Salvador+-+BA,+40301-110/@-12.9734903,-38.5124451,17z/data=!3m1!4b1!4m6!3m5!1s0x71604e7b38f66a7:0xb90fb09cf176ef24!8m2!3d-12.9736369!4d-38.5097201!16s%2Fg%2F1z3t2d_bq
