  levelNm: "Lagoa do Abaet\xE9"
  desc: "A Lagoa do Abaet\xE9, \xE9 uma maravilha natural que cativa os visitantes
    com sua beleza serena e import\xE2ncia cultural. \xC9 uma lagoa cercada por vegeta\xE7\xE3o
    exuberante, dunas de areia e uma praia encantadora, criando um o\xE1sis de tranquilidade
    longe da agita\xE7\xE3o da cidade. Acredita-se que seja habitado por seres e
    esp\xEDritos m\xEDticos, conferindo \xE0 \xE1rea uma aura m\xEDstica"
  levelId: 1
  completed: 0
  objectivesDone: 0
