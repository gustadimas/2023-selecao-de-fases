--- !u!114 &647423705
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 647423703}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1241c28f57348b8418c3c0c970473a7a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  levelNm: "Dique do Toror\xF3"
  desc: "O Dique do Toror\xF3, \xE9 um lago pitoresco e ic\xF4nico que possui imenso
    significado cultural e recreativo. Adornado com esculturas monumentais, tornou-se
    um local de encontro amado tanto para os moradores quanto para os visitantes.
    Uma das caracter\xEDsticas mais marcantes do Dique do Toror\xF3 \xE9 seu acervo
    de esculturas monumentais representando os Orix\xE1s, divindades da religi\xE3o
    afro-brasileira do candombl\xE9. Essas impressionantes esculturas, criadas pelo
    renomado artista baiano Tatti Moreno, erguem-se ao redor do lago, criando um
    ambiente encantador e espiritual"
  levelId: 4
  completed: 0
  objectivesDone: 0
  isSelected: 0
  GMlink: https://www.google.com.br/maps/place/Dique+Toror%C3%B3/@-12.9852861,-38.5093213,17z/data=!3m1!4b1!4m6!3m5!1s0x71604954372eaf3:0xcd8e77275a3c0915!8m2!3d-12.9844852!4d-38.5063431!16s%2Fg%2F112yfndwy
